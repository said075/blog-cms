    {
      "name": "Posts",
      "item": [
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "authorId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "categoryId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "PUBLISHED",
                  "disabled": true
                },
                {
                  "key": "tags",
                  "value": "nodejs,typescript",
                  "disabled": true
                },
                {
                  "key": "sortBy",
                  "value": "createdAt",
                  "disabled": true
                },
                {
                  "key": "sortOrder",
                  "value": "desc",
                  "disabled": true
                }
              ]
            },
            "description": "Get all posts with advanced filtering, pagination, search, and sorting.\n\nQuery Parameters:\n- page: Page number (default: 1)\n- limit: Items per page (default: 10)\n- search: Search in title/content/excerpt\n- authorId: Filter by author\n- categoryId: Filter by category\n- status: DRAFT, PUBLISHED, ARCHIVED\n- tags: Comma-separated tags\n- sortBy: createdAt, title, viewCount, publishedAt\n- sortOrder: asc, desc"
          },
          "response": []
        },
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('postId', response.data.id);",
                  "    console.log('✅ Post ID saved:', response.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Getting Started with Node.js and TypeScript\",\n  \"content\": \"This is a comprehensive guide to building modern backend applications with Node.js and TypeScript. We'll cover everything from setup to deployment, including best practices for production environments.\",\n  \"excerpt\": \"Learn how to build production-ready Node.js APIs with TypeScript\",\n  \"featuredImage\": \"https://images.unsplash.com/photo-1587620962725-abab7fe55159\",\n  \"tags\": [\"nodejs\", \"typescript\", \"backend\", \"api\"],\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"]
            },
            "description": "Create a new post.\n\nRequires: AUTHOR or ADMIN role\n\nAutomatically generates a unique slug from the title."
          },
          "response": []
        },
